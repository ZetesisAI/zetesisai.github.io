---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Metrics from '../components/Metrics.astro';
import Features from '../components/Features.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import Quotes from '../components/Quotes.astro';
import { getCollection } from 'astro:content';
import { ArrowRight, Sparkles } from '@lucide/astro';
import Github from '../components/icons/Github.astro';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2);
---

<Layout
  title="Zetesis AI — Autonomous Intelligence & Multi-Agent Systems"
  description="Zetesis AI is an open research and engineering collective pioneering deterministic multi-agent coordination, code cartography, and empirical AI evaluation."
>
  <!-- OpenAI Customer Stories Style Hero & Featured Story Banner -->
  <Hero />

  <!-- 4-Stat Impact Metrics Bar -->
  <Metrics />

  <!-- Core Project Stories Matrix -->
  <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <h2 class="text-xs uppercase tracking-widest text-cyan-400 font-mono font-semibold mb-2">Architectures & Implementations</h2>
        <p class="text-3xl font-bold text-white tracking-tight">System Case Studies</p>
      </div>
      <a
        href="/projects"
        class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-cyan-400 hover:text-cyan-300 transition-colors mt-4 md:mt-0"
      >
        <span>View all system stories</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          category={project.data.category}
          status={project.data.status}
          githubUrl={project.data.githubUrl}
          demoUrl={project.data.demoUrl}
          slug={project.id}
        />
      ))}
    </div>
  </section>

  <!-- Editorial Quotes & Impact Section -->
  <Quotes />

  <!-- Architectural Pillars -->
  <Features />

  <!-- Recent Research & Publications -->
  <section class="py-24 border-t border-white/[0.06] relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <h2 class="text-xs uppercase tracking-widest text-indigo-400 font-mono font-semibold mb-2">Dispatches & Papers</h2>
          <p class="text-3xl font-bold text-white tracking-tight">Research & Publications</p>
        </div>
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-indigo-400 hover:text-indigo-300 transition-colors mt-4 md:mt-0"
        >
          <span>Browse all articles</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {recentPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            author={post.data.author}
            tags={post.data.tags}
            slug={post.id}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Celestial CTA Section -->
  <section class="py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="relative rounded-3xl p-8 sm:p-16 overflow-hidden border border-white/[0.08] bg-gradient-to-br from-indigo-950/40 via-[#030611]/80 to-cyan-950/30 text-center backdrop-blur-2xl shadow-[0_0_50px_rgba(0,0,0,0.5)]">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[500px] h-[300px] bg-cyan-500/15 blur-[120px] pointer-events-none"></div>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono text-cyan-300 bg-white/[0.04] border border-white/[0.08] mb-6">
        <Sparkles class="w-3.5 h-3.5" />
        <span>Join the Inquiry</span>
      </div>

      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-5 leading-tight">
        Build with the Zetesis Open Ecosystem
      </h2>
      <p class="max-w-xl mx-auto text-slate-300 text-sm sm:text-base mb-10 leading-relaxed font-light">
        Whether orchestrating multi-agent collectives, integrating AST code cartography, or contributing empirical benchmarks, we welcome builders worldwide.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="https://github.com/ZetesisAI"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white text-slate-950 font-semibold text-xs tracking-wide hover:bg-slate-200 transition-all hover:scale-[1.02] shadow-[0_0_20px_rgba(255,255,255,0.2)]"
        >
          <Github class="w-4 h-4" />
          <span>Follow on GitHub</span>
        </a>
        <a
          href="/about"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white/[0.06] hover:bg-white/[0.1] text-white font-medium text-xs border border-white/10 hover:border-cyan-400/30 transition-all hover:scale-[1.02]"
        >
          <span>Read the Mission</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
