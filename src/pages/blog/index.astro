---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { BookOpen } from '@lucide/astro';

const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout
  title="Research & Dispatches — Zetesis AI"
  description="Read research papers, architectural retrospectives, and technical dispatches from the Zetesis AI team."
>
  <div class="py-20 md:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-white/[0.04] border border-indigo-500/20 text-indigo-300 mb-4">
        <BookOpen class="w-3.5 h-3.5" />
        <span>Dispatches & Technical Insights</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
        Research & Articles
      </h1>
      <p class="text-base sm:text-lg text-slate-400 leading-relaxed font-light">
        Documenting our empirical observations, benchmark experiments, and design trade-offs while engineering deterministic autonomous intelligence.
      </p>
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {publishedPosts.map((post) => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          author={post.data.author}
          tags={post.data.tags}
          slug={post.id}
        />
      ))}
    </div>
  </div>
</Layout>
