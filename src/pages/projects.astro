---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { Layers } from '@lucide/astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Architectures & Case Studies — Zetesis AI"
  description="Explore the Zetesis AI open-source systems matrix spanning multi-agent orchestration, knowledge engines, and empirical evaluation suites."
>
  <div class="py-20 md:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-white/[0.04] border border-cyan-500/20 text-cyan-300 mb-4">
        <Layers class="w-3.5 h-3.5" />
        <span>Systems & Architectures</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
        Architectures & Case Studies
      </h1>
      <p class="text-base sm:text-lg text-slate-400 leading-relaxed font-light">
        Explore how each core system within the Zetesis collective is architected for deterministic execution, reproducibility, and high-performance developer workflows.
      </p>
    </div>

    <!-- Project Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          category={project.data.category}
          status={project.data.status}
          githubUrl={project.data.githubUrl}
          demoUrl={project.data.demoUrl}
          slug={project.id}
        />
      ))}
    </div>
  </div>
</Layout>
