---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { Layers } from '@lucide/astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="项目矩阵 - Zetesis AI"
  description="浏览 Zetesis AI 开源项目矩阵，涵盖智能体调度平台、知识引擎及评估测试集。"
>
  <div class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-white/5 border border-white/10 text-cyan-300 mb-4">
        <Layers class="w-3.5 h-3.5" />
        <span>开源软件与工具库</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
        项目矩阵 (Project Matrix)
      </h1>
      <p class="text-lg text-slate-400 leading-relaxed font-light">
        Zetesis AI 致力于开发高可靠、高确定性的人工智能工程底座。所有项目均秉持开源与可重现原则设计。
      </p>
    </div>

    <!-- Project Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          category={project.data.category}
          status={project.data.status}
          githubUrl={project.data.githubUrl}
          demoUrl={project.data.demoUrl}
          slug={project.id}
        />
      ))}
    </div>
  </div>
</Layout>

