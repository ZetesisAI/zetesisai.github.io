---
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';
import { ArrowUpRight, FileText, Code } from '@lucide/astro';
import { getPapers, formatDate } from '../../data/papers';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
  const papers = await getPapers();
  return papers.map((paper) => ({ params: { slug: paper.id }, props: { paper } }));
}

const { paper } = Astro.props;
const { Content, headings } = await render(paper);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const { title, abstract, pubDate, authors, tags, links } = paper.data;

const linkItems = [
  links.pdf && { label: 'Read the paper', href: links.pdf, icon: FileText },
  links.arxiv && { label: 'arXiv', href: links.arxiv, icon: FileText },
  links.code && { label: 'Code', href: links.code, icon: Code },
].filter(Boolean) as { label: string; href: string; icon: typeof FileText }[];

// Up to two other papers for the "More research" footer
const more = (await getPapers()).filter((p) => p.id !== paper.id).slice(0, 2);
---

<Layout title={`${title} — Zetesis AI`} description={abstract}>
  <!-- Title banner: full-width, dark gradient, large title bottom-left -->
  <section class="relative overflow-hidden bg-[radial-gradient(at_50%_120%,#0c1c29,#030a0f_70%)] border-b border-white/[0.06]">
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-cyan-500/10 blur-[140px] pointer-events-none"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 min-h-[300px] md:min-h-[400px] flex flex-col justify-end pt-20 pb-12 md:pb-16">
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-mono text-slate-400 mb-6">
        <span class="text-cyan-300">{tags[0] ?? 'Research'}</span>
        <span class="text-slate-600">·</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, 'long')}</time>
      </p>
      <h1 class="max-w-5xl text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.08]">{title}</h1>
    </div>
  </section>

  <!-- Article on a solid band so the starfield never sits behind text -->
  <div class="bg-[#070b16]/95 border-b border-white/[0.06]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 lg:grid lg:grid-cols-12 lg:gap-6">
      <!-- Sticky table of contents (left 2 columns on desktop) -->
      {toc.length > 0 && (
        <nav id="paper-toc" aria-label="Table of contents" class="hidden lg:block lg:col-span-2 lg:sticky lg:top-28 self-start">
          <ul class="flex flex-col gap-4 text-xs leading-tight">
            {toc.map((h) => (
              <li class={h.depth === 3 ? 'pl-3.5' : ''}>
                <a href={`#${h.slug}`} data-toc={h.slug} class="block text-slate-500 hover:text-white transition-colors">{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <!-- Body: middle 6 of 12 columns -->
      <article class="lg:col-start-4 lg:col-span-6 min-w-0">
        <p class="text-lg sm:text-xl text-slate-200 leading-relaxed">{abstract}</p>

        {linkItems.length > 0 && (
          <div class="flex flex-wrap gap-3 mt-8">
            {linkItems.map(({ label, href, icon: Icon }, i) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class={`inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold transition-all hover:scale-[1.02] ${
                  i === 0
                    ? 'bg-white text-slate-950 hover:bg-slate-200'
                    : 'bg-white/[0.06] hover:bg-white/[0.1] text-white border border-white/10'
                }`}
              >
                <Icon class="w-4 h-4" />
                <span>{label}</span>
              </a>
            ))}
          </div>
        )}

        <div class="paper mt-14">
          <Content />
        </div>

        <!-- Tags, authors, notes: rounded block like the reference page's citations box -->
        <footer class="mt-20 rounded-2xl bg-white/[0.04] border border-white/[0.06] p-6 sm:p-8 flex flex-col gap-8">
          {tags.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="text-xs font-mono px-3 py-1.5 rounded-xl bg-white/[0.05] text-slate-200">{tag}</li>
              ))}
            </ul>
          )}
          <div>
            <p class="text-sm text-slate-400 mb-2">Authors</p>
            <p class="text-slate-100">{authors.join(', ')}</p>
          </div>
          <div>
            <p class="text-sm text-slate-400 mb-2">Cite</p>
            <p class="text-sm font-mono text-slate-300 break-words">
              {authors.join(", ")}. "{title}." {pubDate.getUTCFullYear()}. {Astro.url.href}
            </p>
          </div>
        </footer>
      </article>
    </div>
  </div>

  <!-- More research -->
  {more.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="flex items-baseline justify-between mb-8">
        <h2 class="text-2xl font-bold text-white tracking-tight">More research</h2>
        <a href="/#research" class="text-xs font-mono text-cyan-300 hover:text-white transition-colors">View all</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {more.map((p) => (
          <a href={`/research/${p.id}`} class="celestial-card group rounded-2xl p-6 sm:p-8 flex flex-col">
            <p class="text-xs font-mono text-slate-400 mb-4">{formatDate(p.data.pubDate)}</p>
            <h3 class="text-lg sm:text-xl font-semibold text-white leading-snug group-hover:text-cyan-200 transition-colors">{p.data.title}</h3>
            <span class="mt-6 inline-flex items-center gap-1.5 text-xs font-mono text-cyan-300">
              Read <ArrowUpRight class="w-3.5 h-3.5" />
            </span>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>

<script>
  // Highlight the table-of-contents entry for the section currently in view.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('#paper-toc a[data-toc]'));
  if (links.length > 0) {
    const targets = links
      .map((a) => document.getElementById(a.dataset.toc!))
      .filter((el): el is HTMLElement => el !== null);

    const setActive = (id: string) => {
      for (const a of links) {
        const on = a.dataset.toc === id;
        a.classList.toggle('text-white', on);
        a.classList.toggle('text-slate-500', !on);
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );
    targets.forEach((t) => observer.observe(t));
    if (targets[0]) setActive(targets[0].id);
  }
</script>

<style is:global>
  /* Article typography. Works for Markdown and for raw HTML (e.g. LaTeX converted with LaTeXML or pandoc). */
  .paper {
    color: #e2e8f0;
    font-size: 1.0625rem;
    line-height: 1.8;
  }
  .paper h1,
  .paper h2,
  .paper h3,
  .paper h4 {
    color: #ffffff;
    font-weight: 700;
    letter-spacing: -0.01em;
    scroll-margin-top: 7rem;
  }
  .paper h1 { font-size: 1.875rem; margin: 3rem 0 1rem; }
  .paper h2 { font-size: 1.625rem; margin: 3.5rem 0 1.25rem; }
  .paper h3 { font-size: 1.25rem; margin: 2.5rem 0 0.75rem; }
  .paper h4 { font-size: 1.05rem; margin: 1.75rem 0 0.5rem; }
  .paper > :first-child { margin-top: 0; }
  .paper p { margin-bottom: 1.5rem; }
  .paper strong { color: #ffffff; font-weight: 600; }
  .paper a { color: #ffffff; text-decoration: underline; text-decoration-color: rgba(103, 232, 249, 0.6); text-underline-offset: 4px; }
  .paper a:hover { text-decoration-color: #67e8f9; }
  .paper ul,
  .paper ol { margin: 0 0 1.5rem 1.5rem; }
  .paper ul { list-style: disc; }
  .paper ol { list-style: decimal; }
  .paper li { margin-bottom: 0.5rem; }
  .paper li::marker { color: #94a3b8; }
  .paper blockquote {
    border-left: 2px solid rgba(255, 255, 255, 0.3);
    padding-left: 1.25rem;
    color: #cbd5e1;
    margin: 2rem 0;
  }
  .paper code {
    background: rgba(255, 255, 255, 0.07);
    padding: 0.15rem 0.4rem;
    border-radius: 0.375rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85em;
    color: #f8fafc;
  }
  .paper pre {
    background: #02040a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.875rem;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 2rem 0;
  }
  .paper pre code { background: transparent; padding: 0; }

  /* Tables and figures sit in a bordered box, like the reference page's charts */
  .paper table {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 2.5rem 0;
    padding: 1rem 1.25rem;
    font-size: 0.9375rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.02);
  }
  .paper th,
  .paper td {
    padding: 0.7rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    text-align: left;
  }
  .paper tr:last-child td { border-bottom: 0; }
  .paper figure table { margin: 0 0 0.5rem; padding: 0; border: 0; background: transparent; }
  .paper th { color: #ffffff; font-weight: 600; border-bottom-color: rgba(255, 255, 255, 0.3); }
  .paper figure {
    margin: 2.5rem 0;
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.02);
  }
  .paper img { max-width: 100%; border-radius: 0.5rem; margin: 2.5rem auto; }
  .paper figure img { margin: 0 auto; }
  .paper figcaption { font-size: 0.875rem; color: #94a3b8; text-align: center; margin-top: 0.75rem; }

  /* Author block at the top of a paper */
  .paper .author-block { font-size: 0.95rem; line-height: 1.7; margin-bottom: 2.5rem; }
  .paper .author-block strong { font-weight: 600; }
  .paper .author-block sup { font-size: 0.7em; color: #94a3b8; margin-left: 1px; }
  .paper .author-block .affil { color: #94a3b8; font-size: 0.875rem; }
  .paper .author-block a { color: #cbd5e1; text-decoration-color: rgba(203, 213, 225, 0.4); }

  /* Numbered reference list */
  .paper ol.references { margin-left: 0; padding-left: 2.25rem; font-size: 0.9375rem; color: #cbd5e1; }
  .paper ol.references li { margin-bottom: 0.9rem; scroll-margin-top: 7rem; }
  .paper ol.references li:target { color: #ffffff; }
  .paper ol.references li::marker { color: #67e8f9; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.85em; }

  /* Figures hold images that may have a light background */
  .paper figure img { background: #ffffff; }

  /* KaTeX */
  .paper .katex { color: #f8fafc; font-size: 1.08em; }
  .paper .katex-display {
    margin: 2rem 0;
    padding: 0.75rem 0;
    overflow-x: auto;
    overflow-y: hidden;
  }
</style>
