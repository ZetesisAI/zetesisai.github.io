---
import Layout from '../layouts/Layout.astro';
import { Compass, Lightbulb, Shield, Code, Users } from '@lucide/astro';
import Github from '../components/icons/Github.astro';
---

<Layout
  title="About — Zetesis AI"
  description="Discover the origin, philosophy, and engineering principles behind Zetesis AI."
>
  <div class="py-20 md:py-28 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-white/[0.04] border border-cyan-500/20 text-cyan-300 mb-6">
        <Compass class="w-3.5 h-3.5" />
        <span>Philosophy & Origin</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-6">
        About Zetesis AI
      </h1>
      <p class="text-base sm:text-lg text-slate-300 font-light leading-relaxed">
        The name <strong class="text-white font-medium">Zetesis</strong> (<em class="text-cyan-300">ζήτησις</em>) originates from classical Greek philosophy, signifying relentless, methodical inquiry and the unyielding pursuit of empirical truth.
        In an era of rapid AI proliferation, we adhere to the scientific ethos: engineering transparent, controllable, and deterministic foundations for autonomous intelligence.
      </p>
    </div>

    <!-- Vision & Mission Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="celestial-card p-8 rounded-2xl">
        <div class="w-11 h-11 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-300 mb-6 shadow-[0_0_12px_rgba(99,102,241,0.2)]">
          <Lightbulb class="w-5 h-5" />
        </div>
        <h2 class="text-xl font-bold text-white mb-3">Our Vision</h2>
        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-light">
          We envision a future where complex software engineering, scientific discovery, and operational workflows are accomplished through seamless collaboration between human experts and autonomous agent collectives. By developing modular orchestration protocols and verifiable state machines, we give creators true determinism over agent behavior.
        </p>
      </div>

      <div class="celestial-card p-8 rounded-2xl">
        <div class="w-11 h-11 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-300 mb-6 shadow-[0_0_12px_rgba(6,182,212,0.2)]">
          <Shield class="w-5 h-5" />
        </div>
        <h2 class="text-xl font-bold text-white mb-3">Engineering Principles</h2>
        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-light">
          We reject treating black-box outputs as production-grade truth. Every decision boundary, tool invocation, and memory transition must offer complete audit logs, replay capability, and automated regression testing.
        </p>
      </div>
    </div>

    <!-- Core Research Directions -->
    <div class="celestial-card p-8 sm:p-12 rounded-3xl">
      <h2 class="text-2xl font-bold text-white mb-6">Core Research & Engineering Thrusts</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
        <div class="space-y-2">
          <h3 class="font-semibold text-cyan-300 text-sm font-mono uppercase tracking-wider">Swarm Coordination</h3>
          <p class="text-xs text-slate-400 leading-relaxed font-light">
            Long-horizon planning, hierarchical task decomposition, multi-agent game-theoretic negotiations, and graph-structured state workflows.
          </p>
        </div>
        <div class="space-y-2">
          <h3 class="font-semibold text-indigo-300 text-sm font-mono uppercase tracking-wider">AST-Native Code RAG</h3>
          <p class="text-xs text-slate-400 leading-relaxed font-light">
            Deep syntactic parsing, call-graph topology indexing, and semantic flow modeling for precise monorepo code generation.
          </p>
        </div>
        <div class="space-y-2">
          <h3 class="font-semibold text-purple-300 text-sm font-mono uppercase tracking-wider">Empirical Verification</h3>
          <p class="text-xs text-slate-400 leading-relaxed font-light">
            Automated red-teaming, zero-trust sandbox execution, and objective multi-turn task completion benchmarking.
          </p>
        </div>
      </div>
    </div>

    <!-- Contact & Connect -->
    <div class="text-center space-y-6 pt-6">
      <h2 class="text-2xl font-bold text-white">Join the Community</h2>
      <p class="text-slate-400 text-xs sm:text-sm max-w-md mx-auto font-light">
        We welcome researchers, system architects, and open-source contributors to collaborate on GitHub.
      </p>
      <div class="flex items-center justify-center gap-4">
        <a
          href="https://github.com/ZetesisAI"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 hover:border-cyan-400/40 text-white text-xs font-semibold tracking-wide transition-all hover:scale-[1.02]"
        >
          <Github class="w-4 h-4" />
          <span>GitHub / ZetesisAI</span>
        </a>
      </div>
    </div>
  </div>
</Layout>
