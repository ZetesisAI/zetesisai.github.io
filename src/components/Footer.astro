---
import { Globe } from '@lucide/astro';
import Github from './icons/Github.astro';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/[0.08] bg-[#02040a]/90 text-slate-400 relative z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Brand Info -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="relative w-8 h-8 flex items-center justify-center">
            <div class="absolute inset-0 bg-cyan-500/20 rounded-full blur-sm"></div>
            <img
              src="/logo-trimmed.png"
              alt="Zetesis AI Logo"
              class="relative w-8 h-8 object-contain"
            />
          </div>
          <span class="text-base font-bold text-white tracking-tight">
            Zetesis<span class="text-indigo-400 font-light">AI</span>
          </span>
        </div>
        <p class="text-xs text-slate-400 max-w-sm leading-relaxed">
          Rooted in the ancient Greek concept of <em class="text-slate-300">ζήτησις</em> (continuous inquiry and scientific exploration).
          Engineering open, deterministic multi-agent architectures and reproducible intelligence benchmarks.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://github.com/ZetesisAI"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="p-2 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] text-slate-400 hover:text-white transition-colors border border-white/[0.06]"
          >
            <Github class="w-4 h-4" />
          </a>
          <a
            href="https://zetesisai.github.io"
            aria-label="Official Website"
            class="p-2 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] text-slate-400 hover:text-white transition-colors border border-white/[0.06]"
          >
            <Globe class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-slate-300 tracking-wider uppercase font-mono">Navigation</h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/" class="hover:text-cyan-300 transition-colors">Overview</a>
          </li>
          <li>
            <a href="/projects" class="hover:text-cyan-300 transition-colors">Projects</a>
          </li>
          <li>
            <a href="/blog" class="hover:text-cyan-300 transition-colors">Research & Articles</a>
          </li>
          <li>
            <a href="/about" class="hover:text-cyan-300 transition-colors">About</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Community & Resources -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-slate-300 tracking-wider uppercase font-mono">Ecosystem</h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="https://github.com/ZetesisAI" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 transition-colors">
              GitHub Organization
            </a>
          </li>
          <li>
            <a href="https://github.com/ZetesisAI/zetesisai.github.io" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 transition-colors">
              Website Repository
            </a>
          </li>
          <li>
            <a href="/sitemap-index.xml" class="hover:text-cyan-300 transition-colors">
              Sitemap Index
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 border-t border-white/[0.06] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {currentYear} Zetesis AI. All rights reserved.</p>
      <p class="flex items-center gap-1.5">
        Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-slate-200 underline">Astro</a>
        & deployed on GitHub Pages.
      </p>
    </div>
  </div>
</footer>
