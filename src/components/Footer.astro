---
import Github from './icons/Github.astro';
import { site } from '../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/[0.06] bg-[#02040a]/80 text-slate-500 relative z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col sm:flex-row items-center justify-between gap-6 text-xs">
    <a href="/" class="flex items-center gap-2.5">
      <img src="/logo-trimmed.png" alt="" class="w-6 h-6 object-contain opacity-80" />
      <span class="font-semibold text-slate-300">
        Zetesis<span class="text-indigo-400 font-light">AI</span>
      </span>
    </a>
    <p>© {currentYear} Zetesis AI. All rights reserved.</p>
    <a href={site.github} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-white transition-colors">
      <Github class="w-4 h-4" />
      <span>GitHub</span>
    </a>
  </div>
</footer>
