---
import { Calendar, ArrowRight } from '@lucide/astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  tags: string[];
  slug: string;
}

const { title, description, pubDate, author, tags, slug } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(pubDate);
---

<article class="celestial-card group p-7 rounded-2xl flex flex-col justify-between">
  <div>
    <div class="flex flex-wrap items-center gap-3 text-xs text-slate-400 mb-3 font-mono">
      <div class="flex items-center gap-1.5">
        <Calendar class="w-3.5 h-3.5 text-cyan-400" />
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      </div>
      <span class="text-slate-600">•</span>
      <span>{author}</span>
    </div>

    <h3 class="text-lg sm:text-xl font-bold text-white mb-2 group-hover:text-cyan-300 transition-colors">
      <a href={`/blog/${slug}`}>
        {title}
      </a>
    </h3>

    <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-6 line-clamp-2 font-light">
      {description}
    </p>
  </div>

  <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between text-xs">
    <div class="flex flex-wrap gap-1.5">
      {tags.slice(0, 2).map((tag) => (
        <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/[0.04] text-slate-300 border border-white/[0.06]">
          #{tag}
        </span>
      ))}
    </div>

    <a
      href={`/blog/${slug}`}
      class="inline-flex items-center gap-1 font-medium text-cyan-400 group-hover:text-cyan-300 transition-colors"
    >
      <span>Read Article</span>
      <ArrowRight class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
    </a>
  </div>
</article>
