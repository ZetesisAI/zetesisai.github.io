---
// Metrics impact section inspired by OpenAI Customer Stories
const metrics = [
  {
    stat: '99.4%',
    label: 'State Determinism',
    description: 'Guaranteed execution state convergence across multi-turn agent rollouts.',
  },
  {
    stat: '10x',
    label: 'AST Graph Traversal',
    description: 'Faster context retrieval across monorepos exceeding 1M+ lines of code.',
  },
  {
    stat: '10,000+',
    label: 'Verification Cases',
    description: 'Empirically tested benchmarks assessing reasoning and tool invocation.',
  },
  {
    stat: '100%',
    label: 'Open Architecture',
    description: 'POSIX-compliant sandboxes and model-agnostic orchestration.',
  },
];
---

<section class="py-16 border-y border-white/[0.06] bg-[#02040a]/60 relative z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 divide-y lg:divide-y-0 lg:divide-x divide-white/[0.06]">
      {metrics.map((item, idx) => (
        <div class={`pt-6 lg:pt-0 ${idx !== 0 ? 'lg:pl-8' : ''}`}>
          <div class="text-3xl sm:text-4xl font-extrabold text-white font-mono tracking-tight mb-2 text-celestial">
            {item.stat}
          </div>
          <div class="text-xs font-semibold text-cyan-300 uppercase tracking-wider font-mono mb-1">
            {item.label}
          </div>
          <p class="text-xs text-slate-400 font-light leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

