---
import { Bot, Network, ShieldCheck, Cpu, Code2, Layers } from '@lucide/astro';

const features = [
  {
    icon: Bot,
    title: 'Autonomous Swarm Orchestration',
    description: 'Hierarchical task planning, extended context persistence, asynchronous event streaming, and deterministic state-machine execution.',
    tag: 'Orchestration',
  },
  {
    icon: Network,
    title: 'AST-Native Code Cartography',
    description: 'Combining abstract syntax tree topology with hybrid semantic & graph retrieval to supply pinpoint contextual awareness for large monorepos.',
    tag: 'Code RAG',
  },
  {
    icon: ShieldCheck,
    title: 'Empirical Verification Engine',
    description: 'Rejecting black-box intuition. Standardized test suites for hallucination elimination, automated rollback, and task reproducibility.',
    tag: 'Verification',
  },
  {
    icon: Cpu,
    title: 'Ultra-Low Latency Kernel',
    description: 'Engineered in modern Rust & TypeScript with zero bloated overhead, designed to embed seamlessly in edge runtimes and cloud swarms.',
    tag: 'Performance',
  },
  {
    icon: Code2,
    title: 'Developer-First Toolchain',
    description: 'POSIX-compliant sandboxes, standardized CLI utilities, declarative YAML agent specs, and automated CI/CD integration.',
    tag: 'Dev Experience',
  },
  {
    icon: Layers,
    title: 'Model-Agnostic Hybrid Routing',
    description: 'Seamlessly distribute inference across frontier proprietary models and specialized open-source weights with zero vendor lock-in.',
    tag: 'Open Ecosystem',
  },
];
---

<section class="py-24 relative border-t border-white/[0.06]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest text-cyan-400 font-mono font-semibold mb-3">Architectural Pillars</h2>
      <p class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        Engineered for Mission-Critical Complexity
      </p>
      <p class="mt-4 text-slate-400 text-base leading-relaxed font-light">
        Transcending simple prompt chains. We re-engineer how agents plan, inspect tools, execute code, and verify factual assertions.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature) => {
        const Icon = feature.icon;
        return (
          <div class="celestial-card group p-7 rounded-2xl transition-all duration-300">
            <div class="flex items-center justify-between mb-5">
              <div class="w-11 h-11 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-300 group-hover:bg-cyan-500/20 group-hover:scale-105 transition-all shadow-[0_0_12px_rgba(6,182,212,0.15)]">
                <Icon class="w-5 h-5" />
              </div>
              <span class="text-[10px] font-mono uppercase tracking-wider px-2.5 py-1 rounded-full bg-white/[0.04] text-slate-400 border border-white/[0.06]">
                {feature.tag}
              </span>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2 group-hover:text-cyan-300 transition-colors">
              {feature.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-light">
              {feature.description}
            </p>
          </div>
        );
      })}
    </div>
  </div>
</section>
