---
import Github from './icons/Github.astro';
import { site } from '../data/site';

const navItems = [
  { name: 'About', href: '/#about' },
  { name: 'Research', href: '/#research' },
  { name: 'Team', href: '/#team' },
];
---

<header class="sticky top-0 z-40 w-full border-b border-white/[0.06] bg-[#02040a]/70 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-3 group">
        <div class="relative w-8 h-8 flex items-center justify-center">
          <div class="absolute inset-0 bg-cyan-500/20 rounded-full blur-sm group-hover:bg-cyan-400/40 transition-colors"></div>
          <img
            src="/logo-trimmed.png"
            alt=""
            class="relative w-8 h-8 object-contain transition-transform duration-300 group-hover:scale-105"
            loading="eager"
          />
        </div>
        <span class="text-base font-bold tracking-tight text-white group-hover:text-cyan-300 transition-colors">
          Zetesis<span class="text-indigo-400 font-light">AI</span>
        </span>
      </a>

      <nav class="flex items-center gap-1 sm:gap-2">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="hidden sm:block px-3 py-1.5 rounded-lg text-xs font-medium tracking-wide text-slate-400 hover:text-white hover:bg-white/[0.04] transition-colors"
          >
            {item.name}
          </a>
        ))}
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="ml-1 p-2 rounded-lg text-slate-300 bg-white/[0.04] hover:bg-white/[0.1] border border-white/10 hover:border-cyan-500/30 transition-all"
        >
          <Github class="w-4 h-4" />
        </a>
      </nav>
    </div>
  </div>
</header>
