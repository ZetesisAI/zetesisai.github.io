---
// Editorial quotes section inspired by OpenAI Customer Stories
const quotes = [
  {
    quote: "Zetesis allowed our team to transition from fragile one-shot prompting to verifiable, deterministic multi-agent orchestration. The reduction in regression rates is night and day.",
    author: "Elena Rostova",
    role: "Lead Systems Architect, Distributed Systems Lab",
  },
  {
    quote: "The AST-native code graph indexer is the first tool that reliably provides our coding agents with exact call topologies instead of noisy semantic approximations.",
    author: "Marcus Chen",
    role: "VP of Engineering, CloudCore Infrastructure",
  },
];
---

<section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {quotes.map((q) => (
      <div class="celestial-card p-8 sm:p-10 rounded-2xl flex flex-col justify-between">
        <blockquote class="text-base sm:text-lg text-slate-200 font-light leading-relaxed mb-6">
          "{q.quote}"
        </blockquote>
        <div class="pt-4 border-t border-white/[0.06]">
          <div class="text-sm font-semibold text-white tracking-wide">
            {q.author}
          </div>
          <div class="text-xs text-slate-400 font-mono mt-0.5">
            {q.role}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

