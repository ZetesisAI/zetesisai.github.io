---
import { ArrowRight, Sparkles } from '@lucide/astro';

const categories = [
  { name: 'All Stories', href: '#', active: true },
  { name: 'Agent Coordination', href: '#', active: false },
  { name: 'Code Cartography', href: '#', active: false },
  { name: 'Empirical Verification', href: '#', active: false },
];
---

<section class="relative pt-16 pb-20 md:pt-24 md:pb-24 overflow-hidden z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header: Editorial Style like OpenAI Customer Stories -->
    <div class="max-w-4xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-white/[0.04] border border-cyan-500/25 text-cyan-300 mb-6 backdrop-blur-md">
        <Sparkles class="w-3.5 h-3.5 text-cyan-400" />
        <span>ARCHITECTURES & IMPACT STORIES</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-6 leading-[1.1]">
        Stories of impact, scale, <br class="hidden sm:inline" />
        <span class="text-celestial">and autonomous intelligence.</span>
      </h1>

      <p class="text-base sm:text-xl text-slate-300 font-light leading-relaxed max-w-3xl">
        Discover how developers, research institutes, and enterprises leverage the open-source Zetesis ecosystem to orchestrate autonomous agents, index complex monorepos, and deploy verifiable AI systems.
      </p>
    </div>

    <!-- Category Filter Bar (OpenAI Style) -->
    <div class="flex flex-wrap items-center gap-2 mb-12 pb-4 border-b border-white/[0.08]">
      {categories.map((cat) => (
        <button
          type="button"
          class={`px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-200 cursor-pointer ${
            cat.active
              ? 'bg-white text-slate-950 shadow-[0_0_15px_rgba(255,255,255,0.25)] font-semibold'
              : 'bg-white/[0.04] text-slate-400 hover:text-white hover:bg-white/[0.08] border border-white/[0.06]'
          }`}
        >
          {cat.name}
        </button>
      ))}
    </div>

    <!-- Featured Spotlight Hero Card (OpenAI Customer Story Spotlight) -->
    <div class="celestial-card rounded-3xl p-6 sm:p-10 lg:p-12 transition-all duration-500 hover:border-cyan-400/30">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left: Editorial Story Narrative -->
        <div class="lg:col-span-7 space-y-6 text-left">
          <div class="flex items-center gap-3">
            <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-semibold px-2.5 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20">
              Featured Story
            </span>
            <span class="text-xs font-mono text-slate-400">
              Autonomous Systems
            </span>
          </div>

          <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-snug">
            Engineering deterministic swarms: How distributed engineering teams achieve 99.4% task completion with Zetesis Agent Platform
          </h2>

          <p class="text-sm sm:text-base text-slate-300 font-light leading-relaxed">
            By replacing brittle prompt chains with a state-machine execution kernel, teams eliminate tool-invocation regressions and run automated agent refactoring across complex production services.
          </p>

          <!-- Key Metrics Callout -->
          <div class="grid grid-cols-2 gap-4 pt-2 pb-2">
            <div class="p-4 rounded-xl bg-white/[0.03] border border-white/[0.06]">
              <div class="text-2xl sm:text-3xl font-extrabold text-white font-mono">99.4%</div>
              <div class="text-xs text-slate-400 font-mono mt-0.5">Execution Determinism</div>
            </div>
            <div class="p-4 rounded-xl bg-white/[0.03] border border-white/[0.06]">
              <div class="text-2xl sm:text-3xl font-extrabold text-white font-mono">10x</div>
              <div class="text-xs text-slate-400 font-mono mt-0.5">Faster Context Convergence</div>
            </div>
          </div>

          <div class="pt-2">
            <a
              href="/projects#agent-platform"
              class="inline-flex items-center gap-2 text-sm font-semibold text-cyan-300 hover:text-white transition-colors group"
            >
              <span>Explore architectural case study</span>
              <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </a>
          </div>
        </div>

        <!-- Right: Visual Artwork with Transparent Logo & Orbit -->
        <div class="lg:col-span-5 flex items-center justify-center">
          <div class="relative w-64 h-64 sm:w-80 sm:h-80 flex items-center justify-center">
            <!-- Ambient Glow -->
            <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-cyan-500/15 via-indigo-600/20 to-purple-600/15 blur-2xl animate-celestial-pulse"></div>

            <!-- Concentric Orbital Rings -->
            <div class="absolute inset-2 rounded-full border border-cyan-500/20 animate-celestial-orbit">
              <div class="absolute -top-1 left-1/2 -translate-x-1/2 w-2 h-2 rounded-full bg-cyan-300 shadow-[0_0_10px_#67e8f9]"></div>
            </div>
            <div class="absolute inset-8 rounded-full border border-indigo-500/15" style="animation: celestial-orbit 50s linear infinite reverse;">
              <div class="absolute bottom-4 right-6 w-1.5 h-1.5 rounded-full bg-indigo-300 shadow-[0_0_8px_#a5b4fc]"></div>
            </div>

            <!-- Backdrop Disk -->
            <div class="absolute inset-10 rounded-full bg-[#050814]/85 backdrop-blur-md border border-white/10 shadow-[inset_0_0_25px_rgba(56,189,248,0.2)]"></div>

            <!-- High-Res Transparent Logo -->
            <img
              src="/logo-trimmed.png"
              alt="Zetesis AI Emblem"
              class="relative z-10 w-36 h-36 sm:w-44 sm:h-44 object-contain drop-shadow-[0_0_30px_rgba(56,189,248,0.5)] transition-transform duration-500 hover:scale-105"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
