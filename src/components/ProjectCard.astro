---
import { ArrowRight, ExternalLink } from '@lucide/astro';
import Github from './icons/Github.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  status: 'Active' | 'Beta' | 'Research' | 'Archived';
  githubUrl?: string;
  demoUrl?: string;
  slug?: string;
}

const { title, description, category, status, githubUrl, demoUrl, slug } = Astro.props;

const statusStyles: Record<string, string> = {
  Active: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  Beta: 'bg-amber-500/10 text-amber-300 border-amber-500/30',
  Research: 'bg-cyan-500/10 text-cyan-300 border-cyan-500/30',
  Archived: 'bg-slate-500/10 text-slate-400 border-slate-500/30',
};

// Distinct cosmic gradients for card banners
const gradientMap: Record<string, string> = {
  'Agent Framework': 'from-indigo-950/70 via-purple-950/40 to-slate-950',
  'Knowledge Retrieval': 'from-cyan-950/70 via-blue-950/40 to-slate-950',
  'Benchmarking & Eval': 'from-purple-950/70 via-indigo-950/40 to-slate-950',
};
const cardGrad = gradientMap[category] || 'from-slate-900 via-indigo-950/40 to-slate-950';
---

<div class="celestial-card group relative flex flex-col justify-between rounded-2xl overflow-hidden transition-all duration-300 hover:scale-[1.01]">
  <!-- Visual Header (OpenAI Stories 16:9 visual banner) -->
  <div class={`h-40 w-full bg-gradient-to-br ${cardGrad} border-b border-white/[0.06] p-6 flex flex-col justify-between relative overflow-hidden`}>
    <div class="absolute -right-6 -bottom-6 w-32 h-32 bg-cyan-500/10 rounded-full blur-2xl group-hover:bg-cyan-400/20 transition-colors"></div>

    <div class="flex items-center justify-between relative z-10">
      <span class="text-[11px] font-mono uppercase tracking-wider font-semibold text-cyan-300 px-2.5 py-0.5 rounded-full bg-white/[0.06] border border-white/[0.08]">
        {category}
      </span>
      <span class={`text-[10px] font-mono uppercase tracking-wider font-semibold px-2 py-0.5 rounded-full border ${statusStyles[status] || statusStyles.Active}`}>
        {status}
      </span>
    </div>

    <!-- Architectural Monogram / Subtle Emblem -->
    <div class="relative z-10 flex items-center justify-between text-xs font-mono text-slate-400">
      <span class="text-white/40 tracking-widest text-[10px]">CASE STUDY</span>
      <div class="w-2 h-2 rounded-full bg-cyan-400/80 shadow-[0_0_8px_#38bdf8]"></div>
    </div>
  </div>

  <!-- Content Body -->
  <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
    <div>
      <h3 class="text-xl font-bold text-white mb-3 group-hover:text-cyan-300 transition-colors leading-snug">
        {slug ? (
          <a href={`/projects#${slug}`} class="focus:outline-none">
            {title}
          </a>
        ) : (
          title
        )}
      </h3>

      <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-light mb-6">
        {description}
      </p>
    </div>

    <!-- Card Action Links -->
    <div class="flex items-center justify-between pt-4 border-t border-white/[0.06] text-xs">
      <div class="flex items-center gap-3">
        {githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 text-slate-400 hover:text-white transition-colors"
          >
            <Github class="w-3.5 h-3.5" />
            <span>Code</span>
          </a>
        )}
        {demoUrl && (
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 text-slate-400 hover:text-cyan-300 transition-colors"
          >
            <ExternalLink class="w-3.5 h-3.5" />
            <span>Demo</span>
          </a>
        )}
      </div>

      <a
        href="/projects"
        class="inline-flex items-center gap-1.5 font-semibold text-cyan-400 hover:text-white transition-colors group-hover:translate-x-0.5"
      >
        <span>Read story</span>
        <ArrowRight class="w-3.5 h-3.5 transition-transform" />
      </a>
    </div>
  </div>
</div>
