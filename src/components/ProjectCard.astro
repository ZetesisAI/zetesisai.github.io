---
import { ExternalLink, ArrowRight } from '@lucide/astro';
import Github from './icons/Github.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  status: 'Active' | 'Beta' | 'Research' | 'Archived';
  githubUrl?: string;
  demoUrl?: string;
  slug?: string;
}

const { title, description, category, status, githubUrl, demoUrl, slug } = Astro.props;

const statusStyles: Record<string, string> = {
  Active: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
  Beta: 'bg-amber-500/10 text-amber-400 border-amber-500/20',
  Research: 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
  Archived: 'bg-slate-500/10 text-slate-400 border-slate-500/20',
};
---

<div class="group relative flex flex-col justify-between p-6 rounded-2xl bg-white/[0.02] border border-white/10 hover:border-indigo-500/30 hover:bg-white/[0.04] transition-all duration-300 hover:-translate-y-1">
  <div>
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class="text-xs font-medium px-2.5 py-0.5 rounded-full bg-white/5 text-slate-300 border border-white/5">
        {category}
      </span>
      <span class={`text-[11px] font-semibold px-2 py-0.5 rounded-full border ${statusStyles[status] || statusStyles.Active}`}>
        {status}
      </span>
    </div>

    <h3 class="text-xl font-bold text-white mb-2 group-hover:text-cyan-300 transition-colors">
      {slug ? (
        <a href={`/projects#${slug}`} class="focus:outline-none">
          {title}
        </a>
      ) : (
        title
      )}
    </h3>

    <p class="text-sm text-slate-400 leading-relaxed mb-6">
      {description}
    </p>
  </div>

  <div class="flex items-center justify-between pt-4 border-t border-white/5 text-sm">
    <div class="flex items-center gap-3">
      {githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 text-xs text-slate-400 hover:text-white transition-colors"
        >
          <Github class="w-4 h-4" />
          <span>Code</span>
        </a>
      )}
      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 text-xs text-slate-400 hover:text-cyan-300 transition-colors"
        >
          <ExternalLink class="w-4 h-4" />
          <span>Demo</span>
        </a>
      )}
    </div>

    <a
      href="/projects"
      class="inline-flex items-center gap-1 text-xs font-semibold text-indigo-400 hover:text-cyan-300 transition-colors"
    >
      <span>详情</span>
      <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
    </a>
  </div>
</div>
